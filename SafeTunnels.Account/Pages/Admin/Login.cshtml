@page "/admin/login"
@model SafeTunnels.Account.Pages.Admin.LoginModel
@{ ViewData["Title"] = "ورود مدیر"; }
<section class="message-card login-card"><span class="eyebrow">مدیریت سامانه</span><h1>ورود مدیر</h1><p>با حساب مدیریت خود وارد شوید.</p><form method="post"><div asp-validation-summary="All" class="error-summary" role="alert"></div><div class="field"><label asp-for="Password">رمز عبور</label><input asp-for="Password" type="password" dir="ltr" autocomplete="current-password" required /></div><button class="primary-button" type="submit">ورود به پنل مدیریت</button></form></section>
