@page "/admin"
@model SafeTunnels.Account.Pages.Admin.DashboardModel
@{ ViewData["Title"] = "پنل مدیریت"; }
<section class="dashboard">
    <div class="panel-heading"><div><span class="eyebrow">مدیریت ثبت اطلاعات</span><h1>نمای کلی سامانه</h1></div><form method="post" asp-page-handler="Logout"><button type="submit" class="secondary-button">خروج</button></form></div>
    <div class="stats"><div><span>افراد ثبت‌شده</span><strong>@Model.People</strong></div><div><span>حساب‌های بانکی</span><strong>@Model.Accounts</strong></div><div><span>آخرین ثبت (UTC)</span><strong class="date-stat">@(Model.LastRegistration?.ToString("yyyy/MM/dd HH:mm") ?? "—")</strong></div></div>
    <div class="admin-toolbar"><form method="get" class="search-form"><label class="sr-only" for="search">جست‌وجو</label><input id="search" name="Search" value="@Model.Search" maxlength="100" placeholder="نام، نام خانوادگی یا شماره همراه" /><button class="secondary-button">جست‌وجو</button></form><form method="post" asp-page-handler="Export"><input type="hidden" name="Search" value="@Model.Search" /><button class="secondary-button">خروجی CSV ماسک‌شده</button> <button asp-page-handler="ExportExcel" class="secondary-button">خروجی اکسل ماسک‌شده</button></form></div>
    <div class="table-wrap"><table><thead><tr><th>نام و نام خانوادگی</th><th>همراه</th><th>کد پیگیری</th><th>ثبت (UTC)</th><th>جزئیات</th></tr></thead><tbody>
    @foreach (var a in Model.Applicants) {
        <tr><td>@a.FirstName @a.LastName</td><td dir="ltr">@(a.Mobile ?? "—")</td><td class="code-cell">@a.TrackingCode</td><td>@a.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td><td><details><summary>@a.BankAccounts.Count حساب</summary><div class="bank-details">@foreach (var bank in a.BankAccounts) { <div><strong>بانک @bank.BankName</strong><p>شبا: <bdi>@Model.Mask(bank)</bdi></p></div> }</div></details></td></tr>
    }
    @if (Model.Applicants.Count == 0) { <tr><td colspan="5" class="empty-state">اطلاعاتی یافت نشد.</td></tr> }
    </tbody></table></div>
    <nav class="pagination" aria-label="صفحه‌بندی">@if(Model.PageNumber > 1) { <a asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber - 1)">صفحه قبل</a> }<span>صفحه @Model.PageNumber از @Model.TotalPages</span>@if(Model.PageNumber < Model.TotalPages) { <a asp-route-Search="@Model.Search" asp-route-PageNumber="@(Model.PageNumber + 1)">صفحه بعد</a> }</nav>
</section>
