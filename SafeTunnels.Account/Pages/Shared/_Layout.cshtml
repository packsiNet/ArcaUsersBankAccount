<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] | آرکاکوین</title>
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header"><span class="secure-pill"><span class="status-dot"></span> سامانه ثبت اطلاعات</span></header>
    <aside class="investor-notice" aria-label="اطلاعیه سرمایه‌گذاران">
        <p>با توجه به نزدیک شدن زمان پرداخت به سرمایه‌گذاران آرکاکوین، این پنل صرفاً برای تسریع در جمع‌آوری اطلاعات سرمایه‌گذاران ایجاد شده است.</p>
        <p>اطلاعات شما نزد تیم آرکاکوین محرمانه و محفوظ خواهد ماند.</p>
    </aside>
    <main>@RenderBody()</main>
    <footer class="site-footer"><span>اطلاعات شما، با احترام به حریم خصوصی</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
